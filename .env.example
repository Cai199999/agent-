# ============================================================
# 全局
# ============================================================
APP_ENV=dev
PROJECT_ROOT=.
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================
# 端口
# ============================================================
WEB_PORT=5180
JAVA_PORT=8200
PYTHON_PORT=8300

# ============================================================
# MySQL（共享实例，独立库 + 最小权限账号）
# ============================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agent_gongdan_db
MYSQL_USER=agent_gongdan_app
MYSQL_PASSWORD=change_me
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/agent_gongdan_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_POOL_MIN=5
MYSQL_POOL_MAX=20
MYSQL_CONNECT_TIMEOUT_MS=3000
MYSQL_SOCKET_TIMEOUT_MS=30000

# ============================================================
# Redis（共享实例，强制前缀）
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=agent_gongdan:
REDIS_TIMEOUT_MS=1000
REDIS_CACHE_TTL_SECONDS=300

# ============================================================
# MinIO（共享实例，独立 bucket）
# ============================================================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=agent-gongdan
MINIO_PRESIGN_EXPIRE_SECONDS=600

# ============================================================
# Milvus Lite（项目内数据目录）
# ============================================================
MILVUS_LOCAL_PATH=./data/milvus/milvus.db
MILVUS_COLLECTION_KNOWLEDGE=agent_gongdan_kb_bge_m3_1024_v1
MILVUS_COLLECTION_TICKET=agent_gongdan_ticket_bge_m3_1024_v1
MILVUS_COLLECTION_TICKETS=agent_gongdan_ticket_bge_m3_1024_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=FLAT
MILVUS_TOP_K=5
MILVUS_SCORE_THRESHOLD=0.35
EMBEDDING_DIM=1024

# ============================================================
# LLM（DeepSeek OpenAI 兼容）
# ============================================================
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=change_me
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ============================================================
# Embedding（SiliconFlow OpenAI 兼容）
# ============================================================
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=change_me
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_BATCH_SIZE=16

# ============================================================
# 服务间通信（方向拆分 + current/next 轮换）
# ============================================================
INTERNAL_TOKEN_J2P_CURRENT=change_me
INTERNAL_TOKEN_J2P_NEXT=change_me
INTERNAL_TOKEN_P2J_CURRENT=change_me
INTERNAL_TOKEN_P2J_NEXT=change_me
JAVA_INTERNAL_BASE_URL=http://127.0.0.1:8200
PYTHON_BASE_URL=http://127.0.0.1:8300
JAVA_TO_PY_CONNECT_TIMEOUT_MS=1000
JAVA_TO_PY_READ_TIMEOUT_MS=30000
JAVA_TO_PY_SSE_IDLE_TIMEOUT_MS=60000
PY_TO_JAVA_CONNECT_TIMEOUT_MS=1000
PY_TO_JAVA_READ_TIMEOUT_MS=5000
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_MS=300

# ============================================================
# 鉴权与安全
# ============================================================
JWT_SECRET=change_me
JWT_EXPIRE_SECONDS=7200
JWT_REFRESH_EXPIRE_SECONDS=604800
AUTH_WHITELIST=/api/v1/auth/login,/api/v1/auth/refresh,/health,/ready
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# ============================================================
# 限流 / 熔断
# ============================================================
RATE_LIMIT_QPS=50
RATE_LIMIT_BURST=100
CB_FAILURE_RATE_THRESHOLD=50
CB_SLOW_CALL_DURATION_MS=3000
CB_WAIT_DURATION_SECONDS=30
CB_PERMITTED_HALF_OPEN=3
# MVP 轻量自愈熔断器（P1 切换 Resilience4j 后保留为兼容参数）
AI_GUARD_FAILURE_THRESHOLD=3
AI_GUARD_OPEN_SECONDS=15
AI_GUARD_MAX_OPEN_SECONDS=60
SSE_MAX_PER_USER=2
SSE_MAX_GLOBAL=200

# ============================================================
# 文件与附件
# ============================================================
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=pdf,docx,md,png,jpg
ATTACHMENT_PRESIGN_EXPIRE_SECONDS=600

# ============================================================
# AI 行为参数
# ============================================================
TRIAGE_CONFIDENCE_THRESHOLD=0.75
TRIAGE_DRAFT_TTL_HOURS=24
TRIAGE_CONNECT_TIMEOUT_MS=1000
TRIAGE_READ_TIMEOUT_MS=10000
ANALYSIS_READ_TIMEOUT_MS=20000
TRIAGE_PROMPT_VERSION=v1
TRIAGE_MAX_HISTORY=6
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=6000
CHAT_HISTORY_MAX_MESSAGES=20
TOOL_RESULT_MAX_CHARS=4000
CHAT_SUMMARY_MAX_CHARS=1500
CHAT_STREAM_TIMEOUT_SECONDS=120
CHAT_STREAM_POOL_SIZE=8
CHAT_STREAM_QUEUE_CAPACITY=64
CHAT_MAX_CONTEXT_CHUNKS=8
AGENT_MAX_STEPS=3
TICKET_VECTOR_POOL_SIZE=2
TICKET_VECTOR_QUEUE_CAPACITY=200
JAVA_BASE_URL=http://127.0.0.1:8200
PYTHON_STREAM_CONNECT_TIMEOUT_MS=1000
PYTHON_STREAM_READ_TIMEOUT_MS=60000
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_STEPS=6
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1
INGEST_MAX_CONCURRENT_JOBS=2
